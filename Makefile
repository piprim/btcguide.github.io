# Local helpers. CI runs the same spellcheck and book build (see .github/workflows).
OUT := _book/out
HEXO := $(OUT)/hexo
REPO ?= https://github.com/piprim/btcguide.github.io
PANDOC_FLAGS := --toc --toc-depth=4 --resource-path=.
# six heading levels need chapter..subparagraph, so build the PDF as a report
PDF_FLAGS := -N --pdf-engine=xelatex --top-level-division=chapter -V documentclass=report -V colorlinks=true -V geometry:margin=2.5cm

.PHONY: spellcheck book book-fr epub epub-fr pdf pdf-fr hexo-pages hexo-sync stale serve clean

spellcheck:
	pyspelling -c .spellcheck.yml

book: $(OUT)/book.md

$(OUT)/book.md: _book/build.py index.html $(wildcard _pages/* _pages/*/* _pages/*/*/* _includes/* _includes/*/*)
	python3 _book/build.py

# English Hexo pages + media for blog.piprime.fr; see _book/HEXO-PAGES-SPEC.md
hexo-pages:
	REPO=$(REPO) python3 _book/hexo.py

# rsync without -u: generated files always win. Refuses if a blog-side page lost the generated comment, in either language.
hexo-sync: hexo-pages
	@test -n "$(BLOG)" || { echo "usage: make hexo-sync BLOG=<path to hexo/source>"; exit 2; }
	@for d in btcguide fr/btcguide; do \
	  if [ -d "$(BLOG)/$$d" ] && grep -raL "Generated by _book/hexo.py" "$(BLOG)/$$d" | grep .; then \
	    echo "refusing to sync: the files above were edited or added in the blog; delete them (French is generated from fr/ here now) or edit the source here"; exit 1; fi; done
	mkdir -p "$(BLOG)/btcguide" "$(BLOG)/media/btcguide"
	rsync -a --delete $(HEXO)/page/btcguide/ "$(BLOG)/btcguide/"
	rsync -a --delete $(HEXO)/media/btcguide/ "$(BLOG)/media/btcguide/"
	@if [ -d $(HEXO)/page/fr/btcguide ]; then mkdir -p "$(BLOG)/fr/btcguide" && rsync -a --delete $(HEXO)/page/fr/btcguide/ "$(BLOG)/fr/btcguide/"; else echo "no French pages to sync"; fi

epub: $(OUT)/btcguide.epub

$(OUT)/btcguide.epub: $(OUT)/book.md
	pandoc $< -o $@ $(PANDOC_FLAGS) --epub-chapter-level=2

# pandoc + xelatex as in CI; falls back to calibre when xelatex is not installed
pdf: $(OUT)/btcguide.pdf

$(OUT)/btcguide.pdf: $(OUT)/book.md
	@if command -v xelatex >/dev/null; then \
	  pandoc $< -o $@ $(PANDOC_FLAGS) $(PDF_FLAGS); \
	else \
	  echo "xelatex not found, converting via calibre instead"; \
	  pandoc $< -o $(OUT)/btcguide.epub $(PANDOC_FLAGS) --epub-chapter-level=2 && ebook-convert $(OUT)/btcguide.epub $@ >/dev/null; \
	fi

# French: same recipes on _book/out/fr; skipped with a warning while fr/index.html is missing (see _book/FRENCH-SPEC.md)
book-fr:
	python3 _book/build.py fr

epub-fr: book-fr
	@if [ -f $(OUT)/fr/book.md ]; then pandoc $(OUT)/fr/book.md -o $(OUT)/fr/btcguide-fr.epub $(PANDOC_FLAGS) --epub-chapter-level=2; else echo "no French book to convert"; fi

pdf-fr: book-fr
	@if [ ! -f $(OUT)/fr/book.md ]; then echo "no French book to convert"; \
	elif command -v xelatex >/dev/null; then pandoc $(OUT)/fr/book.md -o $(OUT)/fr/btcguide-fr.pdf $(PANDOC_FLAGS) $(PDF_FLAGS); \
	else echo "xelatex not found, converting via calibre instead"; \
	  pandoc $(OUT)/fr/book.md -o $(OUT)/fr/btcguide-fr.epub $(PANDOC_FLAGS) --epub-chapter-level=2 && ebook-convert $(OUT)/fr/btcguide-fr.epub $(OUT)/fr/btcguide-fr.pdf >/dev/null; fi

# Translator's work list: French files missing, untracked, stale or orphaned against fr/translated_from.json. Not run in CI.
stale:
	python3 _book/stale.py

serve:
	bundle exec jekyll serve

clean:
	rm -rf $(OUT)
